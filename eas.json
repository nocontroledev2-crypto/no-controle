{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_INTERNAL_BUILD_LABEL": "INTERNO C6"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/mapping.txt"
      ]
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/mapping.txt"
      ]
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
